{
  "name": "proyecto_web",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "pnpm build:js && concurrently -n SERVER,CSS -c blue,green \"pnpm dev:server\" \"pnpm dev:css\"",
    "dev:server": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/styles.css --watch",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/styles.css --minify",
    "build:js": "node -e \"require('fs').copyFileSync(require.resolve('alpinejs/dist/cdn.min.js'), 'public/js/alpine.min.js')\"",
    "build": "pnpm build:js && pnpm build:css && tsc && cp -r src/views dist/views",
    "start": "node dist/server.js"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "alpinejs": "^3.16.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "jsonwebtoken": "^9.0.3",
    "method-override": "^3.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/method-override": "^3.0.0",
    "@types/node": "^26.2.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.19",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
