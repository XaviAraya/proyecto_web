<div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 border border-emerald-200 px-4 py-2 text-sm text-emerald-800 shadow-sm">
  <span class="font-semibold text-emerald-900">UF</span>
  {{#if uf.valor}}
    <span class="font-medium">${{formatMonto uf.valor}}</span>
    <span class="text-emerald-600 text-xs">({{formatFecha uf.fecha}})</span>
  {{else}}
    <span class="text-emerald-600 text-xs">no disponible</span>
  {{/if}}
</div>
