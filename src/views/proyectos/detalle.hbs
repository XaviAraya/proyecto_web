<div class="max-w-lg mx-auto card overflow-hidden">
  <div class="h-2 w-full
    {{#if (eq proyecto.estado 'finalizado')}}bg-emerald-500
    {{else}}{{#if (eq proyecto.estado 'en curso')}}bg-indigo-500
    {{else}}bg-amber-500{{/if}}{{/if}}"></div>

  <div class="p-6 space-y-5">
    <div class="flex items-center justify-between">
      <h1 class="text-xl font-bold text-slate-800">{{proyecto.nombre}}</h1>
      <span class="badge
        {{#if (eq proyecto.estado 'finalizado')}}bg-emerald-100 text-emerald-800
        {{else}}{{#if (eq proyecto.estado 'en curso')}}bg-indigo-100 text-indigo-800
        {{else}}bg-amber-100 text-amber-800{{/if}}{{/if}}">
        {{proyecto.estado}}
      </span>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
      <div class="flex items-start gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <div>
          <dt class="text-slate-500 font-medium">Fecha de inicio</dt>
          <dd class="text-slate-900">{{formatFecha proyecto.fecha_inicio}}</dd>
        </div>
      </div>

      <div class="flex items-start gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <div>
          <dt class="text-slate-500 font-medium">Responsable</dt>
          <dd class="text-slate-900">{{proyecto.responsable}}</dd>
        </div>
      </div>

      <div class="flex items-start gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V6m0 10v2m0-8c-1.11 0-2.08.402-2.599 1" />
        </svg>
        <div>
          <dt class="text-slate-500 font-medium">Monto</dt>
          <dd class="text-slate-900 font-semibold">${{formatMonto proyecto.monto}}</dd>
        </div>
      </div>

      <div class="flex items-start gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-indigo-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <div>
          <dt class="text-slate-500 font-medium">Creado por</dt>
          <dd class="text-slate-900">{{creadorNombre}}</dd>
        </div>
      </div>
    </dl>

    <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
      <a href="/proyectos/{{proyecto.id}}/editar" class="btn-secondary">
        Editar
      </a>
      <a href="/proyectos/{{proyecto.id}}/eliminar" class="btn-danger">
        Eliminar
      </a>
      <a href="/proyectos" class="text-slate-500 hover:text-slate-700 text-sm ml-auto">
        ← Volver al listado
      </a>
    </div>
  </div>
</div>
