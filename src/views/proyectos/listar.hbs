<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-2xl font-bold text-slate-800">Proyectos</h1>
    <p class="text-sm text-slate-500">Gestión y seguimiento de proyectos</p>
  </div>
  {{> uf-widget uf=uf}}
</div>

{{#if error}}{{> alert type="error" message=error}}{{/if}}

<div class="mb-6 flex justify-between items-center">
  <a href="/proyectos/nuevo" class="btn-primary">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
    Nuevo proyecto
  </a>
</div>

{{#unless proyectos.length}}
<div class="card flex flex-col items-center justify-center gap-3 py-16 px-6 text-center">
  <span class="flex items-center justify-center h-12 w-12 rounded-full bg-indigo-100 text-indigo-600">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
    </svg>
  </span>
  <p class="text-slate-600">No hay proyectos registrados actualmente.</p>
  <a href="/proyectos/nuevo" class="btn-primary">Crear el primero</a>
</div>
{{else}}

<!-- Tabla: solo escritorio -->
<div class="hidden md:block card overflow-hidden">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-slate-600 font-semibold">
      <tr>
        <th class="px-5 py-3 text-left">Nombre</th>
        <th class="px-5 py-3 text-left">Inicio</th>
        <th class="px-5 py-3 text-left">Estado</th>
        <th class="px-5 py-3 text-left">Responsable</th>
        <th class="px-5 py-3 text-left">Monto</th>
        <th class="px-5 py-3 text-right">Acciones</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      {{#each proyectos}}
      <tr class="hover:bg-slate-50/70 transition">
        <td class="px-5 py-3 font-medium text-slate-900">{{this.nombre}}</td>
        <td class="px-5 py-3 text-slate-600">{{formatFecha this.fecha_inicio}}</td>
        <td class="px-5 py-3">
          <span class="badge
            {{#if (eq this.estado 'finalizado')}}bg-emerald-100 text-emerald-800
            {{else}}{{#if (eq this.estado 'en curso')}}bg-indigo-100 text-indigo-800
            {{else}}bg-amber-100 text-amber-800{{/if}}{{/if}}">
            {{this.estado}}
          </span>
        </td>
        <td class="px-5 py-3 text-slate-600">{{this.responsable}}</td>
        <td class="px-5 py-3 font-medium text-slate-900">${{formatMonto this.monto}}</td>
        <td class="px-5 py-3">
          <div class="flex items-center justify-end gap-1">
            <a href="/proyectos/{{this.id}}" title="Ver" class="btn-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </a>
            <a href="/proyectos/{{this.id}}/editar" title="Editar" class="btn-icon hover:text-amber-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </a>
            <a href="/proyectos/{{this.id}}/eliminar" title="Eliminar" class="btn-icon hover:text-red-600">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            </a>
          </div>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<!-- Tarjetas: solo mobile -->
<div class="md:hidden space-y-3">
  {{#each proyectos}}
  <div class="card p-4">
    <div class="flex items-start justify-between gap-2">
      <div>
        <p class="font-semibold text-slate-900">{{this.nombre}}</p>
        <p class="text-xs text-slate-500">{{formatFecha this.fecha_inicio}} · {{this.responsable}}</p>
      </div>
      <span class="badge shrink-0
        {{#if (eq this.estado 'finalizado')}}bg-emerald-100 text-emerald-800
        {{else}}{{#if (eq this.estado 'en curso')}}bg-indigo-100 text-indigo-800
        {{else}}bg-amber-100 text-amber-800{{/if}}{{/if}}">
        {{this.estado}}
      </span>
    </div>
    <div class="mt-3 flex items-center justify-between">
      <p class="font-bold text-slate-900">${{formatMonto this.monto}}</p>
      <div class="flex items-center gap-1">
        <a href="/proyectos/{{this.id}}" title="Ver" class="btn-icon">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </a>
        <a href="/proyectos/{{this.id}}/editar" title="Editar" class="btn-icon hover:text-amber-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        </a>
        <a href="/proyectos/{{this.id}}/eliminar" title="Eliminar" class="btn-icon hover:text-red-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </a>
      </div>
    </div>
  </div>
  {{/each}}
</div>
{{/unless}}
